{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo-context.internal/schemas/source-artifact-manifest.v1.schema.json",
  "title": "echo-context deterministic source artifact manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_kind",
    "version",
    "source",
    "extraction_baseline",
    "lock_hash",
    "inventory",
    "tar",
    "source_archive",
    "installable",
    "runtime_authority",
    "state_authority",
    "maturity"
  ],
  "properties": {
    "schema": { "const": "source-artifact-manifest.v1" },
    "artifact_kind": { "const": "source" },
    "version": { "$ref": "#/$defs/version" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "committer_timestamp"],
      "properties": {
        "commit": { "$ref": "#/$defs/oid" },
        "tree": { "$ref": "#/$defs/oid" },
        "committer_timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934591
        }
      }
    },
    "extraction_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "record_sha256"],
      "properties": {
        "commit": { "$ref": "#/$defs/oid" },
        "tree": { "$ref": "#/$defs/oid" },
        "record_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "lock_hash": { "$ref": "#/$defs/digest" },
    "inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/inventoryEntry" }
    },
    "tar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "root", "member_count", "members"],
      "properties": {
        "format": { "const": "ustar" },
        "root": {
          "type": "string",
          "pattern": "^echo-context-(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:\\.[0-9A-Za-z]+)*)?/$"
        },
        "member_count": { "type": "integer", "minimum": 1 },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/tarMember" }
        }
      }
    },
    "source_archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "checksum_filename", "format", "size", "source_archive_sha256"],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^echo-context-.+-source\\.tgz$"
        },
        "checksum_filename": {
          "type": "string",
          "pattern": "^echo-context-.+-source\\.tgz\\.sha256$"
        },
        "format": { "const": "gzip+ustar" },
        "size": { "type": "integer", "minimum": 1 },
        "source_archive_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "installable": { "const": false },
    "runtime_authority": { "const": false },
    "state_authority": { "const": false },
    "maturity": { "const": "DEV" }
  },
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:\\.[0-9A-Za-z]+)*)?$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"
    },
    "mode": {
      "enum": ["0644", "0755"]
    },
    "inventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "blob_oid", "size", "content_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "mode": { "$ref": "#/$defs/mode" },
        "blob_oid": { "$ref": "#/$defs/oid" },
        "size": { "type": "integer", "minimum": 0 },
        "content_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "tarMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "size", "mtime"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "mode": { "$ref": "#/$defs/mode" },
        "size": { "type": "integer", "minimum": 0 },
        "mtime": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934591
        }
      }
    }
  }
}
