{
  "name": "echo-context",
  "version": "0.1.0-dev.136.1",
  "private": true,
  "type": "module",
  "description": "Standalone ECHO context substrate: generic capture, normalization, append-only storage, clustering/retrieval, permissions/health, and the eight read-only context MCP tools. Extracted from Project_echo @ 2971310441b69735cbe759293abd8c4d044bf347.",
  "engines": {
    "node": "22.22.1",
    "npm": "10.9.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test:ci",
    "test:ci": "vitest run --config vitest.ci.config.ts",
    "test:operator": "vitest run --config vitest.operator.config.ts",
    "verify:inventory": "node tools/check-runtime-inventory.mjs --git-dir .git --commit HEAD --manifest provenance/runtime-inventory.v2.json",
    "verify:authority": "node tools/check-repository-authority.mjs --git-dir .git --commit HEAD",
    "verify:artifact": "node tools/verify-source-artifact.mjs",
    "build:artifact": "node tools/build-source-artifact.mjs",
    "scan:secrets": "tools/secret-scan.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "cross-spawn": "7.0.6",
    "smol-toml": "^1.6.1",
    "typescript": "^5.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "vitest": "3.2.6"
  }
}
