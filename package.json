{
  "name": "echo-context",
  "version": "0.1.0-beta.5",
  "private": true,
  "type": "module",
  "description": "Standalone ECHO context daemon and package: bounded capture, append-only SQLite storage, retrieval, health, and a sealed read-only MCP roster.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "echo-context": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "npm-shrinkwrap.json",
    "context-tools.v2.json",
    "schemas/service-api.v1.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "22.22.1",
    "npm": "10.9.4"
  },
  "scripts": {
    "build": "node tools/build-package.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test:ci",
    "test:ci": "vitest run --config vitest.ci.config.ts",
    "test:operator": "vitest run --config vitest.operator.config.ts",
    "verify:inventory": "node tools/check-runtime-inventory.mjs --git-dir .git --commit HEAD --manifest provenance/runtime-inventory.v2.json",
    "verify:authority": "node tools/check-repository-authority.mjs --git-dir .git --commit HEAD",
    "verify:artifact": "node tools/verify-source-artifact.mjs",
    "build:artifact": "node tools/build-source-artifact.mjs",
    "scan:secrets": "tools/secret-scan.sh",
    "smoke:package": "node tools/smoke-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "chokidar": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "tsx": "^4.19.2",
    "vitest": "3.2.6"
  }
}
