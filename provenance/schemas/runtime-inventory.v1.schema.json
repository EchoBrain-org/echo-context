{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema": {
      "const": "runtime-inventory.v1"
    },
    "script_clis": {
      "type": "array",
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "script": {
            "type": "string"
          },
          "class": {
            "const": "npm_javascript_cli"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "script",
          "class",
          "target"
        ],
        "additionalProperties": true
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "entrypoint": {
            "type": "string"
          },
          "edges": {
            "type": "array",
            "items": {
              "$schema": "http://json-schema.org/draft-07/schema#",
              "type": "object",
              "properties": {
                "class": {
                  "enum": [
                    "repository_static_import",
                    "repository_dynamic_literal_import",
                    "repository_commonjs_literal_require",
                    "repository_literal_read",
                    "repository_literal_process_launch",
                    "node_builtin",
                    "npm_package",
                    "npm_javascript_cli",
                    "native_or_system_helper"
                  ]
                },
                "target": {
                  "type": "string"
                }
              },
              "required": [
                "class",
                "target"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "entrypoint",
          "edges"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema",
    "script_clis",
    "entrypoints"
  ],
  "additionalProperties": true
}
