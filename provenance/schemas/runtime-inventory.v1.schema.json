{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "platform", "entrypoint_sources", "script_clis", "npm_closure", "entrypoints"],
  "properties": {
    "schema": { "const": "runtime-inventory.v1" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "cpu"],
      "properties": { "os": { "type": "string" }, "cpu": { "type": "string" } }
    },
    "entrypoint_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "reasons"],
        "properties": {
          "file": { "type": "string" },
          "reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "script_clis": {
      "type": "array",
      "items": { "$ref": "#/definitions/scriptEdge" }
    },
    "npm_closure": {
      "type": "array",
      "items": { "$ref": "#/definitions/npmClosureRow" }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entrypoint", "modules", "edges", "package_roots"],
        "properties": {
          "entrypoint": { "type": "string" },
          "modules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "edges": { "type": "array", "items": { "$ref": "#/definitions/edge" } },
          "package_roots": { "type": "array", "items": { "type": "string", "pattern": "^node_modules/" } }
        }
      }
    }
  },
  "definitions": {
    "scriptEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "class", "target"],
      "properties": {
        "script": { "type": "string" },
        "class": { "enum": ["npm_javascript_cli", "npm_package", "native_or_system_helper"] },
        "target": { "type": "string" },
        "lock_path": { "type": "string", "pattern": "^node_modules/" },
        "package_subpath": { "type": "string" },
        "version": { "type": "string" },
        "integrity": { "type": "string" }
      }
    },
    "npmClosureRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lock_path", "name", "version", "integrity", "dependencies", "runtime_files"],
      "properties": {
        "lock_path": { "type": "string", "pattern": "^node_modules/" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "integrity": { "type": "string", "pattern": "^sha512-" },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "lock_path"],
            "properties": {
              "name": { "type": "string" },
              "kind": { "enum": ["dependency", "optional_dependency", "peer_dependency"] },
              "lock_path": { "type": "string", "pattern": "^node_modules/" }
            }
          }
        },
        "runtime_files": { "type": "array", "items": { "type": "string", "pattern": "^node_modules/" } }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "class", "target"],
      "properties": {
        "from": { "type": "string" },
        "class": {
          "enum": [
            "repository_static_import",
            "repository_dynamic_literal_import",
            "repository_commonjs_literal_require",
            "repository_literal_read",
            "repository_literal_process_launch",
            "node_builtin",
            "npm_package",
            "npm_javascript_cli",
            "native_or_system_helper"
          ]
        },
        "target": { "type": "string" },
        "lock_path": { "type": "string", "pattern": "^node_modules/" },
        "package_subpath": { "type": "string" },
        "version": { "type": "string" },
        "integrity": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
