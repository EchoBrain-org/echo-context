{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema": {
      "const": "parity-matrix.v1"
    },
    "source_commit": {
      "const": "2971310441b69735cbe759293abd8c4d044bf347"
    },
    "ready_content_sha": {
      "const": "aa9fa9d89c30b2ba2823d6b3eecdc32e389120bb9f3bc46538b9335a301c8392"
    },
    "disposition_policy_sha256": {
      "const": "7f905d1e3b64828e7b10e794af2c93a64daf12f92b53b11439b6bf18ac2d7069"
    },
    "counts": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "ported": {
          "const": 144
        },
        "rewritten": {
          "const": 7
        },
        "excluded": {
          "const": 65
        },
        "total": {
          "const": 217
        },
        "duplicated": {
          "const": 1
        }
      },
      "required": [
        "ported",
        "rewritten",
        "excluded",
        "duplicated",
        "total"
      ],
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "minItems": 217,
      "maxItems": 217,
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "ported",
              "rewritten",
              "duplicated",
              "excluded"
            ]
          },
          "source_blob_oid": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "source_content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "target_path": {
            "type": "string",
            "minLength": 1
          },
          "target_content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "rewrite_kind": {
            "type": "string",
            "minLength": 1
          },
          "replay": {
            "type": "string",
            "minLength": 1
          },
          "replay_patch": {
            "type": "string",
            "minLength": 1
          },
          "replay_command": {
            "type": "string",
            "minLength": 1
          },
          "duplication_rationale": {
            "type": "string",
            "minLength": 1
          },
          "excluded_reason": {
            "type": "string",
            "minLength": 1
          },
          "target_blob_oid": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "path",
          "disposition",
          "source_blob_oid",
          "source_content_sha256"
        ],
        "allOf": [
          {
            "if": { "properties": { "disposition": { "const": "ported" } } },
            "then": { "required": ["target_path"] }
          },
          {
            "if": { "properties": { "disposition": { "const": "rewritten" } } },
            "then": {
              "required": [
                "target_path",
                "target_content_sha256",
                "target_blob_oid",
                "summary",
                "rewrite_kind",
                "replay",
                "replay_patch",
                "replay_command"
              ]
            }
          },
          {
            "if": { "properties": { "disposition": { "const": "duplicated" } } },
            "then": {
              "required": [
                "target_path",
                "target_content_sha256",
                "target_blob_oid",
                "duplication_rationale"
              ]
            }
          },
          {
            "if": { "properties": { "disposition": { "const": "excluded" } } },
            "then": {
              "required": ["excluded_reason"],
              "not": { "required": ["target_path"] }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "source_commit",
    "ready_content_sha",
    "disposition_policy_sha256",
    "counts",
    "rows"
  ],
  "additionalProperties": false
}
